#!/usr/bin/env bash
set -euo pipefail

VALID_TYPES="feat fix refactor test docs infra release chore"
VALID_AREAS="ui store build style i18n services security"

usage() {
    cat <<'HELP'
Usage: ./comm -t <type> [-a <area>] [-v <version>] "<message>"

Type tags (-t):
  feat      New functionality
  fix       Bug fix
  refactor  Code restructure, no behaviour change
  test      Adding or updating tests
  docs      Documentation only
  infra     Docker, CI/CD, deployment, config
  release   Version milestone (pairs with -v)
  chore     Dependency updates, cleanup

Area tags (-a, optional):
  ui        Vue components and templates
  store     Pinia / state management
  build     Vite, config, tooling
  style     SCSS, CSS, themes
  i18n      Translations and locale files
  services  Service layer and adapters
  security  Security fixes and hardening

Version (-v, optional):
  Used with -t release to create a git tag.
  Auto-prepends 'v' if missing.

Examples:
  ./comm -t feat -a ui "Add invoice PDF export button"
  ./comm -t fix -a security "Sanitize CSS injection in customizations modal"
  ./comm -t refactor -a store "Migrate invoices module to Pinia"
  ./comm -t infra -a build "Migrate from Vue CLI to Vite"
  ./comm -t release -v 1.0.0 "Open Invoice v1.0.0"
HELP
    exit 0
}

if [ $# -eq 0 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    usage
fi

TYPE=""
AREA=""
VERSION=""
MESSAGE=""
SKIP_CONFIRM=0

while [ $# -gt 0 ]; do
    case "$1" in
        -t) TYPE="$2"; shift 2 ;;
        -a) AREA="$2"; shift 2 ;;
        -v) VERSION="$2"; shift 2 ;;
        -y) SKIP_CONFIRM=1; shift ;;
        -*) echo "Unknown flag: $1"; usage ;;
        *)  MESSAGE="$1"; shift ;;
    esac
done

if [ -z "$TYPE" ]; then
    echo "Error: -t <type> is required."
    echo "Valid types: $VALID_TYPES"
    exit 1
fi

if ! echo "$VALID_TYPES" | grep -qw "$TYPE"; then
    echo "Error: Invalid type '$TYPE'"
    echo "Valid types: $VALID_TYPES"
    exit 1
fi

if [ -n "$AREA" ] && ! echo "$VALID_AREAS" | grep -qw "$AREA"; then
    echo "Error: Invalid area '$AREA'"
    echo "Valid areas: $VALID_AREAS"
    exit 1
fi

if [ -z "$MESSAGE" ]; then
    echo "Error: Commit message is required."
    exit 1
fi

if [ -n "$VERSION" ]; then
    case "$VERSION" in
        v*) ;;
        *)  VERSION="v${VERSION}" ;;
    esac
fi

FULL_MSG="[${TYPE}]"
[ -n "$AREA" ] && FULL_MSG="${FULL_MSG}[${AREA}]"
[ -n "$VERSION" ] && FULL_MSG="${FULL_MSG}[${VERSION}]"
FULL_MSG="${FULL_MSG} ${MESSAGE}"

echo ""
echo "  $FULL_MSG"
echo ""

if [ "$SKIP_CONFIRM" -eq 0 ]; then
    read -rp "Commit? [Y/n] " CONFIRM
    CONFIRM="${CONFIRM:-Y}"
    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
    fi
fi

git commit -m "$FULL_MSG"

if [ -n "$VERSION" ] && [ "$TYPE" = "release" ]; then
    git tag "$VERSION"
    echo "Tagged $VERSION"
fi
